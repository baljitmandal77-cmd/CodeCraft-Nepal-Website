<script>
  // Dynamic handling of the interactive GitHub multi-account selector
  function initGithubMenu() {
    const buttons = document.querySelectorAll('.github-menu-btn');

    buttons.forEach((btn) => {
      const menu = btn.nextElementSibling;
      if (!menu) return;

      // Toggle menu visibility on click
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains('opacity-100');

        // Close all other instances first
        document.querySelectorAll('.github-dropdown-menu').forEach((m) => {
          m.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
          m.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
        });

        if (!isOpen) {
          menu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          menu.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
        }
      });
    });

    // Close menu when clicking anywhere else on the document
    document.addEventListener('click', () => {
      document.querySelectorAll('.github-dropdown-menu').forEach((menu) => {
        menu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
        menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      });
    });
  }

  // Support running on initial load and navigation changes (Astro View Transitions support)
  document.addEventListener('astro:page-load', initGithubMenu);
  // Fallback for standard load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGithubMenu);
  } else {
    initGithubMenu();
  }
</script>
