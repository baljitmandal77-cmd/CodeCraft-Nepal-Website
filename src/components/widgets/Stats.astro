---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <div class="p-5 rounded-2xl bg-transparent dark:bg-transparent backdrop-blur-none border-2 border-indigo-500/40 hover:border-cyan-400 transition-all duration-300 shadow-xl hover:shadow-2xl hover:shadow-cyan-500/25 hover:-translate-y-1 group intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            {icon && (
              <div class="flex items-center justify-center mx-auto mb-3 text-cyan-300 drop-shadow-[0_0_8px_rgba(34,211,238,0.8)]">
                <Icon name={icon} class="w-8 h-8" />
              </div>
            )}
            {amount && (
              <div class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-purple-300 text-3xl sm:text-4xl lg:text-5xl drop-shadow-[0_2px_10px_rgba(34,211,238,0.6)]">
                {amount}
              </div>
            )}
            {title && (
              <div class="mt-2 text-xs sm:text-sm font-bold uppercase tracking-wider text-cyan-200/90 drop-shadow-[0_1px_4px_rgba(56,189,248,0.4)]">
                {title}
              </div>
            )}
          </div>
        ))
    }
  </div>
</WidgetWrapper>
