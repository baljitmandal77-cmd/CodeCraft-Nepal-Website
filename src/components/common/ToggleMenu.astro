---
export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class:
    className = 'flex flex-col h-10 w-10 rounded-xl justify-center items-center cursor-pointer group bg-slate-50/90 hover:bg-slate-100/90 dark:bg-slate-800/60 dark:hover:bg-slate-700/80 backdrop-blur-md border border-slate-200 dark:border-slate-700/60 shadow-sm transition-all duration-300',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} data-aw-toggle-menu>
  <span class="sr-only">{label}</span>
  <slot>
    <div class="relative w-5 h-[14px]">
      <span
        aria-hidden="true"
        class="absolute left-0 top-0 h-[2px] w-5 rounded-full bg-slate-700 dark:bg-slate-200 transition-all duration-300 ease-in-out group-[.expanded]:top-1.5 group-[.expanded]:rotate-45"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-0 top-1.5 h-[2px] w-5 rounded-full bg-slate-700 dark:bg-slate-200 transition-all duration-200 ease-in-out group-[.expanded]:opacity-0"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-0 top-3 h-[2px] w-5 rounded-full bg-slate-700 dark:bg-slate-200 transition-all duration-300 ease-in-out group-[.expanded]:top-1.5 group-[.expanded]:-rotate-45"
      ></span>
    </div>
  </slot>
</button>
