---
import { Icon } from 'astro-icon/components';
---

<div
  id="music-player-widget"
  transition:persist="music-player-widget"
  class="fixed bottom-6 left-6 z-[9999] pointer-events-auto transition-all duration-300 ease-in-out"
>
  <!-- Expanded Music Card (Toggles on click with smooth slide-left animation) -->
  <div
    id="music-card"
    class="hidden mb-3 w-80 max-w-[calc(100vw-3rem)] rounded-2xl bg-slate-900/95 backdrop-blur-md border border-slate-700/70 shadow-2xl p-4 text-white transition-all duration-300 ease-in-out transform opacity-0 -translate-x-[calc(100%+2rem)] pointer-events-none"
  >
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
      <div class="flex items-center gap-2 overflow-hidden">
        <div class="p-1.5 rounded-lg bg-indigo-500/20 text-indigo-400 shrink-0">
          <Icon name="tabler:disc" class="w-5 h-5" id="header-disc-icon" style="animation-duration: 4s;" />
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <h4 class="text-[10px] font-bold uppercase tracking-wider text-indigo-400">Music Player</h4>
            <!-- Equalizer Sound Wave Animation -->
            <div id="equalizer-bars" class="flex items-end gap-0.5 h-3 hidden">
              <span class="w-0.5 bg-indigo-400 rounded-full animate-bounce h-2" style="animation-delay: 0s;"></span>
              <span class="w-0.5 bg-purple-400 rounded-full animate-bounce h-3" style="animation-delay: 0.2s;"></span>
              <span class="w-0.5 bg-pink-400 rounded-full animate-bounce h-1.5" style="animation-delay: 0.4s;"></span>
            </div>
          </div>
          <p id="current-track-title" class="text-xs font-semibold truncate text-slate-200">
            🎧 Lofi Chill Study Beats
          </p>
        </div>
      </div>
      <button
        id="close-music-card"
        class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors shrink-0"
        aria-label="Close"
      >
        <Icon name="tabler:x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Progress Bar -->
    <div class="mt-3">
      <div class="flex justify-between text-[10px] text-slate-400 mb-1 font-mono">
        <span id="audio-time-current">0:00</span>
        <span id="audio-time-total">0:00</span>
      </div>
      <input
        type="range"
        id="audio-progress"
        min="0"
        max="100"
        value="0"
        class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-500"
      />
    </div>

    <!-- Main Controls -->
    <div class="flex items-center justify-between mt-3 px-1">
      <button
        id="prev-track"
        class="text-slate-300 hover:text-white p-2 hover:bg-slate-800/80 rounded-full transition-colors active:scale-95"
        title="Previous Track"
      >
        <Icon name="tabler:player-skip-back-filled" class="w-4 h-4" />
      </button>

      <button
        id="play-pause-btn"
        class="w-10 h-10 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white flex items-center justify-center shadow-lg shadow-indigo-500/30 transition-transform active:scale-95"
        title="Play / Pause"
      >
        <Icon name="tabler:player-play-filled" class="w-5 h-5 ml-0.5" id="card-icon-play" />
        <Icon name="tabler:player-pause-filled" class="w-5 h-5 hidden" id="card-icon-pause" />
      </button>

      <button
        id="next-track"
        class="text-slate-300 hover:text-white p-2 hover:bg-slate-800/80 rounded-full transition-colors active:scale-95"
        title="Next Track"
      >
        <Icon name="tabler:player-skip-forward-filled" class="w-4 h-4" />
      </button>

      <!-- Volume -->
      <div class="flex items-center gap-1">
        <button id="mute-btn" class="text-slate-400 hover:text-white p-1 rounded">
          <Icon name="tabler:volume" class="w-4 h-4" id="vol-icon" />
          <Icon name="tabler:volume-3" class="w-4 h-4 hidden" id="mute-icon" />
        </button>
        <input
          type="range"
          id="volume-slider"
          min="0"
          max="1"
          step="0.05"
          value="0.7"
          class="w-12 h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-500"
        />
      </div>
    </div>

    <!-- Playlist Dropdown (5 Songs) -->
    <div class="mt-3 pt-3 border-t border-slate-800">
      <label class="block text-[10px] text-slate-400 font-medium mb-1 uppercase tracking-wider"
        >Select Track (5 Songs)</label
      >
      <select
        id="playlist-select"
        class="w-full bg-slate-800/90 border border-slate-700 rounded-lg text-xs text-slate-200 px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer truncate"
      >
        <option
          value="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=lofi-study-112191.mp3"
          >🎧 Song 1 - Lofi Chill Study Beats</option
        >
        <option value="/music/song2.mp3">🚀 Song 2 - Cyberpunk Beats</option>
        <option value="/music/song3.mp3">🎹 Song 3 - Ambient Piano</option>
        <option value="/music/song4.mp3">✨ Song 4 - Chill Lofi Focus</option>
        <option value="/music/song5.mp3">🎧 Song 5 - Deep Work Flow</option>
      </select>
    </div>
  </div>

  <!-- Main Floating Trigger Button -->
  <button
    id="music-toggle-btn"
    class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-700 hover:to-pink-700 text-white w-14 h-14 rounded-full shadow-2xl shadow-indigo-500/40 flex items-center justify-center transition-all hover:scale-110 active:scale-95 group border-2 border-white/30 relative animate-float"
    aria-label="Toggle Music Player"
  >
    <!-- Playing Pulse Glow Aura -->
    <span
      id="music-glow-aura"
      class="absolute -inset-1 rounded-full bg-pink-500/30 animate-ping pointer-events-none hidden"></span>

    <!-- Tooltip -->
    <span
      class="absolute left-16 bg-slate-900 text-white text-xs px-2.5 py-1 rounded-md opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-lg border border-slate-700"
    >
      Music Player
    </span>

    <!-- Spinning decorative ring -->
    <div
      id="music-spin-ring"
      class="absolute inset-[3px] rounded-full border-[2px] border-dashed border-white/60 pointer-events-none transition-transform"
      style="animation-duration: 4s;"
    >
    </div>

    <!-- Inner Icons -->
    <Icon name="tabler:music" class="w-6 h-6 drop-shadow-sm z-10" id="music-icon-play" />
    <Icon name="tabler:disc-filled" class="w-6 h-6 drop-shadow-sm z-10 hidden text-pink-300" id="music-icon-pause" />
  </button>
</div>

<script>
  interface CustomWindow extends Window {
    __globalBgAudio?: HTMLAudioElement;
  }

  (function () {
    const win = window as unknown as CustomWindow;

    // Create a global audio instance (not in DOM) to persist across View Transitions flawlessly on iOS
    if (!win.__globalBgAudio) {
      win.__globalBgAudio = new Audio();
      win.__globalBgAudio.preload = 'auto';
      win.__globalBgAudio.volume = 0.7;

      const savedState = sessionStorage.getItem('bgAudioState');
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          if (state.src) win.__globalBgAudio.src = state.src;
          if (state.currentTime > 0) {
            const targetTime = state.currentTime;
            const onLoaded = () => {
              if (win.__globalBgAudio) win.__globalBgAudio.currentTime = targetTime;
              win.__globalBgAudio?.removeEventListener('canplay', onLoaded);
            };
            win.__globalBgAudio.addEventListener('canplay', onLoaded);
            if (win.__globalBgAudio.readyState >= 1) win.__globalBgAudio.currentTime = targetTime;
          }
          if (state.isPlaying) {
            // Mobile auto-play might block this without gesture, but worth a try for SPA reloads
            win.__globalBgAudio.play().catch(() => {});
          }
        } catch {
          console.debug('session read ignored');
        }
      }
    }

    function getAudio(): HTMLAudioElement | null {
      return win.__globalBgAudio || null;
    }

    function formatTime(seconds: number): string {
      if (isNaN(seconds)) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function syncUI() {
      const audio = getAudio();
      if (!audio) return;

      const isPlaying = !audio.paused && audio.currentTime > 0 && !audio.ended;
      const cardIconPlay = document.getElementById('card-icon-play');
      const cardIconPause = document.getElementById('card-icon-pause');
      const mainIconPlay = document.getElementById('music-icon-play');
      const mainIconPause = document.getElementById('music-icon-pause');
      const spinRing = document.getElementById('music-spin-ring');
      const glowAura = document.getElementById('music-glow-aura');
      const headerDisc = document.getElementById('header-disc-icon');
      const equalizerBars = document.getElementById('equalizer-bars');

      if (isPlaying) {
        cardIconPlay?.classList.add('hidden');
        cardIconPause?.classList.remove('hidden');
        mainIconPlay?.classList.add('hidden');
        mainIconPause?.classList.remove('hidden');
        spinRing?.classList.add('animate-spin');
        glowAura?.classList.remove('hidden');
        equalizerBars?.classList.remove('hidden');
        headerDisc?.classList.add('animate-spin');
      } else {
        cardIconPause?.classList.add('hidden');
        cardIconPlay?.classList.remove('hidden');
        mainIconPause?.classList.add('hidden');
        mainIconPlay?.classList.remove('hidden');
        spinRing?.classList.remove('animate-spin');
        glowAura?.classList.add('hidden');
        equalizerBars?.classList.add('hidden');
        headerDisc?.classList.remove('animate-spin');
      }

      // Sync volume slider & icon
      const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement | null;
      const volIcon = document.getElementById('vol-icon');
      const muteIcon = document.getElementById('mute-icon');
      if (volumeSlider) {
        volumeSlider.value = audio.volume.toString();
      }
      if (audio.volume === 0) {
        volIcon?.classList.add('hidden');
        muteIcon?.classList.remove('hidden');
      } else {
        muteIcon?.classList.add('hidden');
        volIcon?.classList.remove('hidden');
      }

      // Sync playlist select & title
      const playlistSelect = document.getElementById('playlist-select') as HTMLSelectElement | null;
      const trackTitle = document.getElementById('current-track-title');
      if (playlistSelect && audio.src) {
        const options = Array.from(playlistSelect.options);
        const match = options.find(
          (opt) => opt.value && (audio.src.includes(encodeURI(opt.value)) || audio.src === opt.value)
        );
        if (match) {
          playlistSelect.value = match.value;
          if (trackTitle) trackTitle.textContent = match.text.replace(/^[^\s]+\s*/, '');
        }
      }

      // Update Mobile MediaSession API
      if ('mediaSession' in navigator && playlistSelect && playlistSelect.selectedIndex >= 0) {
        try {
          const selectedText = playlistSelect.options[playlistSelect.selectedIndex]?.text || 'Lofi Beats';
          navigator.mediaSession.metadata = new MediaMetadata({
            title: selectedText.replace(/^[^\s]+\s*/, ''),
            artist: 'Infinity Code Labs',
            album: 'Background Music',
          });
        } catch (e) {
          console.debug('MediaSession error:', e);
        }
      }
    }

    function updateTimeUI() {
      const audio = getAudio();
      if (!audio) return;

      const progressBar = document.getElementById('audio-progress') as HTMLInputElement | null;
      const timeCurrent = document.getElementById('audio-time-current');
      const timeTotal = document.getElementById('audio-time-total');

      if (!isNaN(audio.duration) && audio.duration > 0) {
        const pct = (audio.currentTime / audio.duration) * 100;
        if (progressBar) progressBar.value = pct.toString();
        if (timeCurrent) timeCurrent.textContent = formatTime(audio.currentTime);
        if (timeTotal) timeTotal.textContent = formatTime(audio.duration);
      }
    }

    function changeTrack(direction: number) {
      const audio = getAudio();
      const playlistSelect = document.getElementById('playlist-select') as HTMLSelectElement | null;
      if (!audio || !playlistSelect) return;

      const options = Array.from(playlistSelect.options);
      let currentIndex = options.findIndex(
        (opt) => opt.value === playlistSelect.value || (audio.src && audio.src.includes(opt.value))
      );
      if (currentIndex === -1) currentIndex = 0;

      const newIndex = (currentIndex + direction + options.length) % options.length;
      playlistSelect.value = options[newIndex].value;
      const val = playlistSelect.value;
      const text = options[newIndex].text;

      const trackTitle = document.getElementById('current-track-title');
      if (trackTitle) trackTitle.textContent = text.replace(/^[^\s]+\s*/, '');

      audio.src = val;
      audio.play().catch(() => {});
      syncUI();
    }

    function initMusicPlayer() {
      const musicWidget = document.getElementById('music-player-widget');
      const audio = getAudio();
      if (!musicWidget || !audio) return;

      const playlistSelect = document.getElementById('playlist-select') as HTMLSelectElement | null;

      // Initialize audio source ONLY IF NOT ALREADY SET
      if (!audio.src && playlistSelect && playlistSelect.value) {
        audio.src = playlistSelect.value;
        audio.volume = 0.7;
      }

      // Bind events once on the persistent widget
      if (!musicWidget.dataset.eventsBound) {
        musicWidget.dataset.eventsBound = 'true';

        audio.addEventListener('play', syncUI);
        audio.addEventListener('pause', syncUI);
        audio.addEventListener('timeupdate', () => {
          updateTimeUI();
          try {
            sessionStorage.setItem(
              'bgAudioState',
              JSON.stringify({
                src: audio.src,
                currentTime: audio.currentTime,
                isPlaying: !audio.paused,
              })
            );
          } catch {
            console.debug('session write ignored');
          }
        });
        audio.addEventListener('ended', () => changeTrack(1));
        audio.addEventListener('error', () => {
          if (!audio.src.includes('pixabay.com')) {
            console.warn('Local MP3 file not found, playing online fallback stream...');
            audio.src =
              'https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=lofi-study-112191.mp3';
            audio.play().catch(() => {});
          }
        });

        if ('mediaSession' in navigator) {
          try {
            navigator.mediaSession.setActionHandler('play', () => audio.play());
            navigator.mediaSession.setActionHandler('pause', () => audio.pause());
            navigator.mediaSession.setActionHandler('previoustrack', () => changeTrack(-1));
            navigator.mediaSession.setActionHandler('nexttrack', () => changeTrack(1));
          } catch (e) {
            console.debug('MediaSession action handler error:', e);
          }
        }

        const toggleBtn = document.getElementById('music-toggle-btn');
        const musicCard = document.getElementById('music-card');
        const closeCard = document.getElementById('close-music-card');
        const playPauseBtn = document.getElementById('play-pause-btn');
        const progressBar = document.getElementById('audio-progress') as HTMLInputElement | null;
        const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement | null;
        const muteBtn = document.getElementById('mute-btn');
        const prevBtn = document.getElementById('prev-track');
        const nextBtn = document.getElementById('next-track');

        function showCard() {
          if (!musicCard) return;
          musicCard.classList.remove('hidden');
          void musicCard.offsetWidth;
          musicCard.classList.remove('opacity-0', '-translate-x-[calc(100%+2rem)]', 'pointer-events-none');
          musicCard.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto');
        }

        function hideCard() {
          if (!musicCard) return;
          musicCard.classList.remove('opacity-100', 'translate-x-0', 'pointer-events-auto');
          musicCard.classList.add('opacity-0', '-translate-x-[calc(100%+2rem)]', 'pointer-events-none');
          setTimeout(() => {
            if (musicCard.classList.contains('opacity-0')) {
              musicCard.classList.add('hidden');
            }
          }, 300);
        }

        function togglePlayPause() {
          if (!audio) return;
          if (!audio.src && playlistSelect && playlistSelect.value) {
            audio.src = playlistSelect.value;
          }
          if (!audio.paused) {
            audio.pause();
          } else {
            audio.play().catch((e) => console.warn('Playback error:', e));
          }
        }

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (musicCard) {
            const isHidden = musicCard.classList.contains('hidden') || musicCard.classList.contains('opacity-0');
            if (isHidden) {
              showCard();
              if (audio.paused) {
                togglePlayPause();
              }
            } else {
              hideCard();
            }
          }
        });

        closeCard?.addEventListener('click', hideCard);
        playPauseBtn?.addEventListener('click', togglePlayPause);

        playlistSelect?.addEventListener('change', () => {
          audio.src = playlistSelect.value;
          const trackTitle = document.getElementById('current-track-title');
          if (trackTitle && playlistSelect.selectedIndex >= 0) {
            trackTitle.textContent = playlistSelect.options[playlistSelect.selectedIndex].text.replace(
              /^[^\s]+\s*/,
              ''
            );
          }
          audio.play().catch(() => {});
        });

        prevBtn?.addEventListener('click', () => changeTrack(-1));
        nextBtn?.addEventListener('click', () => changeTrack(1));

        progressBar?.addEventListener('input', () => {
          if (!isNaN(audio.duration) && audio.duration > 0 && progressBar) {
            const seekTime = (parseFloat(progressBar.value) / 100) * audio.duration;
            audio.currentTime = seekTime;
          }
        });

        volumeSlider?.addEventListener('input', () => {
          if (volumeSlider) {
            audio.volume = parseFloat(volumeSlider.value);
          }
        });

        muteBtn?.addEventListener('click', () => {
          if (audio.volume > 0) {
            audio.volume = 0;
          } else {
            audio.volume = 0.7;
          }
        });

        // Scroll auto-hide logic
        let lastScrollY = window.scrollY;
        let isTicking = false;

        function handleScroll() {
          const currentScrollY = window.scrollY;
          if (!musicWidget) return;

          if (currentScrollY < 60) {
            musicWidget.classList.remove('-translate-x-36', 'opacity-0');
            lastScrollY = currentScrollY;
            isTicking = false;
            return;
          }

          const delta = currentScrollY - lastScrollY;
          if (Math.abs(delta) > 8) {
            if (delta > 0) {
              musicWidget.classList.add('-translate-x-36', 'opacity-0');
            } else {
              musicWidget.classList.remove('-translate-x-36', 'opacity-0');
            }
            lastScrollY = currentScrollY;
          }
          isTicking = false;
        }

        window.addEventListener(
          'scroll',
          () => {
            if (!isTicking) {
              window.requestAnimationFrame(handleScroll);
              isTicking = true;
            }
          },
          { passive: true }
        );
      }

      // Sync state on every page load
      syncUI();
      updateTimeUI();
    }

    let isPlayingBeforeSwap = false;

    document.addEventListener('astro:before-swap', () => {
      const audio = getAudio();
      if (audio) {
        isPlayingBeforeSwap = !audio.paused;
      }
    });

    document.addEventListener('astro:after-swap', () => {
      const audio = getAudio();
      // On some mobile devices, if audio was detached/paused, try to resume
      // Since it's a window object, it shouldn't pause, but if the browser thinks it's a nav and pauses it, this is a fallback.
      if (audio && isPlayingBeforeSwap && audio.paused) {
        audio.play().catch((e) => console.warn('Could not resume audio after swap:', e));
      }
    });

    initMusicPlayer();
    document.addEventListener('astro:page-load', () => {
      initMusicPlayer();
      // Try to resume on page-load as well in case of hard refresh
      const audio = getAudio();
      if (audio && isPlayingBeforeSwap && audio.paused) {
        audio.play().catch((e) => console.warn('Could not resume audio on page-load:', e));
      }
    });
  })();
</script>
