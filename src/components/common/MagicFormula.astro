---
import { Icon } from 'astro-icon/components';
---

<section class="relative py-12 px-4 sm:px-6 overflow-hidden">
  <!-- Glowing Background Accent Circles -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-cyan-500/10 dark:bg-cyan-500/15 rounded-full blur-3xl pointer-events-none animate-pulse"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/4 -translate-y-1/2 w-80 h-80 bg-purple-500/10 dark:bg-purple-500/15 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div
      class="bg-transparent border border-cyan-500/30 rounded-3xl p-6 sm:p-10 shadow-2xl shadow-cyan-950/50 hover:border-cyan-400/50 transition-all duration-300"
    >
      <!-- Tagline -->
      <div class="text-center mb-8">
        <span
          class="inline-flex items-center gap-2 px-5 py-2 rounded-full text-xs sm:text-sm font-extrabold bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-pink-500/10 border-2 border-cyan-400/60 text-cyan-300 uppercase tracking-widest shadow-xl shadow-cyan-500/20 drop-shadow-[0_2px_8px_rgba(34,211,238,0.5)]"
        >
          <Icon name="tabler:sparkles" class="w-4 h-4 text-cyan-300 animate-spin" style="animation-duration: 4s;" />
          The Success Equation
        </span>
        <h3 class="text-2xl sm:text-4xl font-extrabold mt-4 tracking-tight flex flex-col sm:block items-center">
          <span
            class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-300 bg-clip-text text-transparent drop-shadow-[0_2px_12px_rgba(99,102,241,0.6)]"
          >
            Your Vision + My Code
          </span>
          <span class="block sm:inline mt-2 sm:mt-0 text-slate-200">
            <span class="text-pink-400 font-black mx-2 drop-shadow-[0_2px_10px_rgba(244,114,182,0.8)]">=</span>
            <span
              class="bg-gradient-to-r from-pink-400 via-rose-300 to-emerald-300 bg-clip-text text-transparent drop-shadow-[0_2px_12px_rgba(52,211,153,0.6)]"
            >
              Our Product
            </span>
          </span>
        </h3>
        <p
          class="text-sm sm:text-lg bg-gradient-to-r from-cyan-200 via-sky-100 to-purple-200 bg-clip-text text-transparent mt-3 max-w-xl mx-auto font-semibold drop-shadow-[0_2px_10px_rgba(56,189,248,0.4)] border-y border-cyan-500/20 py-2"
        >
          Collaborating to turn innovative ideas into world-class software & digital experiences.
        </p>
      </div>

      <!-- Magic Equation Cards -->
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 sm:gap-5 text-center">
        <!-- Element 1: Your Vision -->
        <div
          class="flex-1 w-full bg-transparent border-2 border-indigo-500/50 rounded-2xl p-5 sm:p-6 hover:scale-[1.03] hover:border-indigo-400 hover:shadow-2xl hover:shadow-indigo-500/30 transition-all duration-300 shadow-xl group"
        >
          <div
            class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-indigo-500/20 border-2 border-indigo-400/50 flex items-center justify-center text-indigo-300 group-hover:bg-indigo-500 group-hover:text-white transition-all shadow-lg shadow-indigo-500/30"
          >
            <Icon name="tabler:bulb" class="w-8 h-8" />
          </div>
          <h4
            class="text-lg sm:text-xl font-extrabold bg-gradient-to-r from-indigo-300 via-sky-200 to-indigo-100 bg-clip-text text-transparent drop-shadow-[0_2px_8px_rgba(129,140,248,0.5)]"
          >
            Your Vision
          </h4>
          <p class="text-xs font-semibold text-indigo-200/90 mt-1.5 drop-shadow-[0_1px_4px_rgba(165,180,252,0.4)]">
            Unique Ideas & Business Goals
          </p>
        </div>

        <!-- Plus Sign -->
        <div
          class="w-10 h-10 rounded-full bg-cyan-500/20 border-2 border-cyan-400/60 flex items-center justify-center text-cyan-300 font-black text-xl shrink-0 shadow-lg shadow-cyan-500/30 drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]"
        >
          +
        </div>

        <!-- Element 2: My Code -->
        <div
          class="flex-1 w-full bg-transparent border-2 border-purple-500/50 rounded-2xl p-5 sm:p-6 hover:scale-[1.03] hover:border-purple-400 hover:shadow-2xl hover:shadow-purple-500/30 transition-all duration-300 shadow-xl group"
        >
          <div
            class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-purple-500/20 border-2 border-purple-400/50 flex items-center justify-center text-purple-300 group-hover:bg-purple-500 group-hover:text-white transition-all shadow-lg shadow-purple-500/30"
          >
            <Icon name="tabler:code" class="w-8 h-8" />
          </div>
          <h4
            class="text-lg sm:text-xl font-extrabold bg-gradient-to-r from-purple-300 via-pink-200 to-purple-100 bg-clip-text text-transparent drop-shadow-[0_2px_8px_rgba(192,132,252,0.5)]"
          >
            My Code
          </h4>
          <p class="text-xs font-semibold text-purple-200/90 mt-1.5 drop-shadow-[0_1px_4px_rgba(216,180,254,0.4)]">
            Clean, Scalable & Secure Tech
          </p>
        </div>

        <!-- Equals Sign -->
        <div
          class="w-10 h-10 rounded-full bg-pink-500/20 border-2 border-pink-400/60 flex items-center justify-center text-pink-300 font-black text-xl shrink-0 shadow-lg shadow-pink-500/30 drop-shadow-[0_0_8px_rgba(244,114,182,0.6)]"
        >
          =
        </div>

        <!-- Element 3: Our Product -->
        <div
          class="flex-1 w-full bg-transparent border-2 border-emerald-400/70 rounded-2xl p-5 sm:p-6 hover:scale-[1.03] hover:border-emerald-300 transition-all duration-300 shadow-2xl shadow-emerald-500/30 group relative overflow-hidden"
        >
          <div class="absolute -right-6 -top-6 w-20 h-20 bg-emerald-400/20 rounded-full blur-xl pointer-events-none">
          </div>
          <div
            class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-emerald-500/20 border-2 border-emerald-400/60 flex items-center justify-center text-emerald-300 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/40"
          >
            <Icon name="tabler:rocket" class="w-8 h-8" />
          </div>
          <h4
            class="text-lg sm:text-xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-200 drop-shadow-[0_2px_8px_rgba(52,211,153,0.6)]"
          >
            Our Product
          </h4>
          <p class="text-xs font-semibold text-emerald-200/90 mt-1.5 drop-shadow-[0_1px_4px_rgba(110,231,183,0.4)]">
            High-Impact Web & Software
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
